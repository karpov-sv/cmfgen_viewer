diff --git a/new_main/mod_subs/init_population_estimates.f90 b/new_main/mod_subs/init_population_estimates.f90
new file mode 100644
--- /dev/null
+++ b/new_main/mod_subs/init_population_estimates.f90
@@ -0,0 +1,355 @@
+! Population reconstruction shared by text restarts and radius regridding.
+module init_population_estimates_mod
+  use set_kind_module
+  use mod_cmfgen
+  use control_variable_mod, only: dc_interp_method
+  use, intrinsic :: ieee_arithmetic, only: ieee_is_finite
+  implicit none
+  private
+  public :: reconstruct_dc_estimates, read_population_estimates
+  type :: initial_ion
+    real(ldp), allocatable :: dc(:,:), seed(:), ion(:), pop(:,:), sup(:,:)
+  end type
+contains
+  subroutine fail(message, lu)
+    character(*), intent(in) :: message
+    integer, intent(in) :: lu
+    write(lu,'(A)') 'Population initialization: '//message
+    error stop 'Invalid population initialization'
+  end subroutine
+
+  ! Keep the original log(b) and continuum estimates while iterating on the
+  ! charged-ion density used by occupation probabilities. Never multiply an
+  ! already converted population by the LTE factor on the next pass.
+  subroutine convert_dc(data, n, ne, temp, ions, dissolve, scale, density, lu)
+    type(initial_ion), intent(inout) :: data(:)
+    integer, intent(in) :: n, lu
+    real(ldp), intent(in) :: ne(n), temp(n), density(n,num_species)
+    real(ldp), intent(inout) :: ions(n)
+    logical, intent(in) :: dissolve, scale
+    real(ldp), allocatable :: lte(:,:), loglte(:,:), occupation(:,:)
+    real(ldp) :: total(n), next_ions(n), unit_ion(n), factor(n), change, value
+    integer :: iteration, species_index, id, first_id, last_id, j, k, nf
+    logical :: converged
+    unit_ion=1.0_ldp
+    ions=max(ions,tiny(1.0_ldp))
+    converged=.false.
+    do iteration=1,100
+      call comp_lev_dis_blk(ne,ions,temp,dissolve,n)
+      next_ions=0.0_ldp
+      do species_index=1,num_species
+        if(.not.species_pres(species_index)) cycle
+        first_id=species_beg_id(species_index)
+        last_id=species_end_id(species_index)-1
+        total=0.0_ldp
+        do id=first_id,last_id
+          if(.not.atm(id)%xzv_pres) cycle
+          data(id)%ion=data(id)%seed
+        end do
+        do id=last_id,first_id,-1
+          if(.not.atm(id)%xzv_pres) cycle
+          nf=atm(id)%nxzv_f
+          allocate(lte(nf,n),loglte(nf,n),occupation(nf,n))
+          ! Unit continuum density keeps the Saha factor representable; its
+          ! actual density is included in the final logarithmic product.
+          call ltepop_wld_v2(lte,loglte,occupation,atm(id)%edgexzv_f,atm(id)%gxzv_f, &
+               atm(id)%zxzv,atm(id)%gionxzv_f,nf,unit_ion,ne,temp,n)
+          data(id)%pop=0.0_ldp
+          do k=1,n
+            if(data(id)%ion(k)>0.0_ldp) then
+              do j=1,nf
+                value=data(id)%dc(j,k)+loglte(j,k)+log(data(id)%ion(k))
+                if(value>log(huge(value))) call fail('population overflows; check input DCs',lu)
+                data(id)%pop(j,k)=exp(value)
+              end do
+            end if
+          end do
+          deallocate(lte,loglte,occupation)
+          if(id>first_id) then
+            if(atm(id-1)%xzv_pres) data(id-1)%ion=data(id)%pop(1,:)
+          end if
+          total=total+sum(data(id)%pop,dim=1)
+          if(.not.atm(id+1)%xzv_pres) total=total+data(id)%ion
+        end do
+        if(any(total<=0.0_ldp).or..not.all(ieee_is_finite(total))) &
+             call fail('zero or non-finite elemental population',lu)
+        if(scale) then
+          factor=density(:,species_index)/total
+          do id=first_id,last_id
+            if(.not.atm(id)%xzv_pres) cycle
+            do k=1,n
+              data(id)%pop(:,k)=data(id)%pop(:,k)*factor(k)
+            end do
+            data(id)%ion=data(id)%ion*factor
+          end do
+        end if
+        do id=first_id,last_id
+          if(.not.atm(id)%xzv_pres) cycle
+          if(atm(id)%zxzv>1.01_ldp) next_ions=next_ions+sum(data(id)%pop,dim=1)
+          if(.not.atm(id+1)%xzv_pres.and.atm(id)%zxzv>0.01_ldp) next_ions=next_ions+data(id)%ion
+        end do
+      end do
+      if(.not.all(ieee_is_finite(next_ions)).or.any(next_ions<=0.0_ldp)) &
+           call fail('invalid charged-ion density',lu)
+      change=maxval(abs(next_ions-ions)/max(next_ions,ions))
+      if(.not.dissolve.or.change<1.0e-10_ldp) then
+        ions=next_ions
+        converged=.true.
+        exit
+      end if
+      ions=0.5_ldp*ions+0.5_ldp*next_ions
+    end do
+    if(.not.converged) call fail('occupation probabilities did not converge in 100 passes',lu)
+    call comp_lev_dis_blk(ne,ions,temp,dissolve,n)
+  end subroutine
+
+  subroutine reconstruct_dc_estimates(n, scale, dissolve, lu)
+    integer, intent(in) :: n, lu
+    logical, intent(in) :: scale, dissolve
+    type(initial_ion) :: data(num_ions)
+    integer :: id, charge_iteration
+    real(ldp) :: charge(n), charge_error
+    logical :: charge_converged
+    do id=1,num_ions-1
+      if(.not.atm(id)%xzv_pres) cycle
+      data(id)%dc=atm(id)%xzv_f
+      data(id)%seed=atm(id)%dxzv_f
+      allocate(data(id)%ion(n),data(id)%pop(atm(id)%nxzv_f,n))
+    end do
+    popion=pop_atom
+    charge_converged=.false.
+    do charge_iteration=1,100
+      call convert_dc(data,n,ed,t,popion,dissolve,scale,pop_species,lu)
+      if(dc_interp_method/='LTE') exit
+      charge=0.0_ldp
+      do id=1,num_ions-1
+        if(.not.atm(id)%xzv_pres) cycle
+        charge=charge+(atm(id)%zxzv-1.0_ldp)*sum(data(id)%pop,dim=1)
+        if(.not.atm(id+1)%xzv_pres) charge=charge+atm(id)%zxzv*data(id)%ion
+      end do
+      if(any(charge<=0.0_ldp).or..not.all(ieee_is_finite(charge))) &
+        call fail('invalid LTE charge sum',lu)
+      charge_error=maxval(abs(charge-ed)/max(charge,ed))
+      if(charge_error<1.0e-10_ldp) then
+        ed=charge
+        charge_converged=.true.
+        exit
+      end if
+      ed=exp(0.5_ldp*(log(ed)+log(charge)))
+    end do
+    if(dc_interp_method=='LTE') then
+      if(.not.charge_converged) call fail('LTE Ne did not converge',lu)
+      write(lu,'(A,I4,A,ES12.4)') 'LTE charge consistency: iterations=', &
+        charge_iteration,' residual=',charge_error
+    end if
+    do id=1,num_ions-1
+      if(.not.atm(id)%xzv_pres) cycle
+      atm(id)%xzv_f=data(id)%pop
+      atm(id)%dxzv_f=data(id)%ion
+    end do
+  end subroutine
+
+  ! Read the formats understood by REGRID_LOG_DC_V1. POP requires matching
+  ! full atoms and a common source grid, rather than silently mixing models.
+  subroutine read_dc_file(filename, radius, ne, temp, clump, data, luin, lu)
+    character(*), intent(in) :: filename
+    real(ldp), allocatable, intent(out) :: radius(:), ne(:), temp(:), clump(:)
+    type(initial_ion), intent(out) :: data
+    integer, intent(in) :: luin, lu
+    character(256) :: line, format_line
+    integer :: ios, i, j, nf, n
+    real(ldp) :: core, lum, unused1, unused2
+    logical :: has_format
+    open(luin,file=filename,status='old',action='read',iostat=ios)
+    if(ios/=0) call fail('cannot open '//filename,lu)
+    has_format=.false.; format_line=' '
+    do i=1,11
+      read(luin,'(A)',iostat=ios) line
+      if(ios/=0) exit
+      if(index(line,'!Format date')/=0) then
+        has_format=.true.; format_line=line; exit
+      end if
+    end do
+    if(.not.has_format) rewind(luin)
+    read(luin,*,iostat=ios) core,lum,nf,n
+    if(ios/=0) call fail('invalid header in '//filename,lu)
+    if(nf<1.or.n<2) call fail('insufficient levels or depths in '//filename,lu)
+    allocate(radius(n),ne(n),temp(n),clump(n),data%dc(nf,n),data%seed(n),data%ion(n),data%pop(nf,n))
+    clump=1.0_ldp
+    do i=1,n
+      if(has_format) then
+        read(luin,*,iostat=ios) radius(i),data%seed(i),ne(i),temp(i),unused1,unused2,clump(i)
+      else
+        read(luin,*,iostat=ios) radius(i),data%seed(i),ne(i),temp(i)
+      end if
+      if(ios/=0) call fail('invalid depth record in '//filename,lu)
+      read(luin,*,iostat=ios) (data%dc(j,i),j=1,nf)
+      if(ios/=0) call fail('invalid departure coefficients in '//filename,lu)
+    end do
+    close(luin)
+    if(.not.all(ieee_is_finite(radius)).or.any(radius<=0.0_ldp)) call fail('invalid radii in '//filename,lu)
+    if(any(radius(2:n)>=radius(1:n-1))) call fail('non-monotonic radii in '//filename,lu)
+    if(.not.all(ieee_is_finite(ne)).or.any(ne<=0.0_ldp)) call fail('invalid Ne in '//filename,lu)
+    if(.not.all(ieee_is_finite(temp)).or.any(temp<=0.0_ldp)) call fail('invalid T in '//filename,lu)
+    if(.not.all(ieee_is_finite(clump)).or.any(clump<=0.0_ldp)) call fail('invalid clumping in '//filename,lu)
+    if(.not.all(ieee_is_finite(data%seed)).or.any(data%seed<0.0_ldp)) call fail('invalid ion density in '//filename,lu)
+    if(.not.all(ieee_is_finite(data%dc))) call fail('non-finite DC in '//filename,lu)
+    if(index(format_line,'10-Dec-2010')/=0) then
+      data%dc=data%dc*log(10.0_ldp)
+    else if(index(format_line,'18-Nov-2010')==0) then
+      if(.not.has_format) then
+        if(abs(data%dc(nf,n))<0.2_ldp) data%dc=data%dc+1.0_ldp
+      end if
+      if(any(data%dc<0.0_ldp)) call fail('negative departure coefficient in '//filename,lu)
+      do i=1,n
+        do j=1,nf
+          if(data%dc(j,i)>0.0_ldp) then
+            data%dc(j,i)=log(data%dc(j,i))
+          else
+            data%dc(j,i)=-huge(1.0_ldp)
+          end if
+        end do
+      end do
+    end if
+  end subroutine
+
+  ! Geometric interpolation for positive fractions. Retain exact zeros and
+  ! exact nodes; a zero endpoint uses linear interpolation without a floor.
+  function interpolate_fraction(a, b, weight) result(value)
+    real(ldp), intent(in) :: a,b,weight
+    real(ldp) :: value
+    if(weight==0.0_ldp) then
+      value=a
+    else if(weight==1.0_ldp) then
+      value=b
+    else if(a>0.0_ldp.and.b>0.0_ldp) then
+      value=exp((1.0_ldp-weight)*log(a)+weight*log(b))
+    else
+      value=(1.0_ldp-weight)*a+weight*b
+    end if
+  end function
+
+  subroutine read_population_estimates(n, dissolve, luin, lu)
+    integer, intent(in) :: n,luin,lu
+    logical, intent(in) :: dissolve
+    type(initial_ion) :: data(num_ions), reference
+    real(ldp), allocatable :: old_r(:),old_ne(:),old_t(:),old_clump(:),rr(:),ee(:),tt(:),cc(:)
+    real(ldp), allocatable :: ions(:),density(:,:),total(:),weights(:,:),group_max(:),group_sum(:)
+    real(ldp) :: weight, factor, value, hdk, chibf,chiff,hdkt,twohcsq
+    common /constants/ chibf,chiff,hdkt,twohcsq
+    integer :: old_n,id,ispec,first_id,last_id,k,j,l,left,nf,ns
+    do ispec=1,num_species
+      if(.not.species_pres(ispec)) cycle
+      do id=species_beg_id(ispec),species_end_id(ispec)-1
+        if(.not.atm(id)%xzv_pres) call fail('POP requires contiguous explicit ion stages',lu)
+      end do
+    end do
+    call read_dc_file('T_IN',old_r,old_ne,old_t,old_clump,reference,luin,lu)
+    old_n=size(old_r)
+    allocate(ions(old_n),density(old_n,num_species),total(old_n))
+    ions=old_ne; density=0.0_ldp
+    do id=1,num_ions-1
+      if(.not.atm(id)%xzv_pres) cycle
+      call read_dc_file(trim(ion_id(id))//'_IN',rr,ee,tt,cc,data(id),luin,lu)
+      if(size(rr)/=old_n.or.size(data(id)%dc,1)/=atm(id)%nxzv_f) &
+           call fail('POP requires matching source full atoms and depth counts: '//trim(ion_id(id)),lu)
+      if(maxval(abs(rr/old_r-1.0_ldp))>1.0e-10_ldp.or. &
+         maxval(abs(ee/old_ne-1.0_ldp))>1.0e-6_ldp.or. &
+         maxval(abs(tt/old_t-1.0_ldp))>1.0e-6_ldp.or. &
+         maxval(abs(cc/old_clump-1.0_ldp))>1.0e-6_ldp) &
+           call fail('POP input files must describe one common source model: '//trim(ion_id(id)),lu)
+    end do
+    call convert_dc(data,old_n,old_ne,old_t,ions,dissolve,.false.,density,lu)
+    do id=1,num_ions-1
+      if(.not.atm(id)%xzv_pres) cycle
+      allocate(data(id)%sup(atm(id)%nxzv,old_n))
+      data(id)%sup=0.0_ldp
+      do j=1,atm(id)%nxzv_f
+        l=atm(id)%f_to_s_xzv(j)
+        data(id)%sup(l,:)=data(id)%sup(l,:)+data(id)%pop(j,:)
+      end do
+    end do
+    ! Match the radius scaling of the existing R interpolation method.
+    if(abs(old_r(old_n)/r(n)-1.0_ldp)>1.0e-4_ldp) old_r=old_r*(r(n)/old_r(old_n))
+    old_r(old_n)=r(n)
+    if(abs(old_r(1)/r(1)-1.0_ldp)<=1.0e-10_ldp) old_r(1)=r(1)
+    if(any(old_r(2:old_n)>=old_r(1:old_n-1))) call fail('radius scaling lost monotonicity',lu)
+    ed=0.0_ldp; popion=0.0_ldp
+    do ispec=1,num_species
+      if(.not.species_pres(ispec)) cycle
+      first_id=species_beg_id(ispec); last_id=species_end_id(ispec)-1
+      total=data(last_id)%ion
+      do id=first_id,last_id
+        total=total+sum(data(id)%sup,dim=1)
+      end do
+      if(any(total<=0.0_ldp)) call fail('zero source elemental population',lu)
+      do k=1,n
+        left=1
+        do while(left<old_n-1)
+          if(r(k)>=old_r(left+1)) exit
+          left=left+1
+        end do
+        weight=max(0.0_ldp,min(1.0_ldp,log(old_r(left)/r(k))/log(old_r(left)/old_r(left+1))))
+        if(abs(r(k)/old_r(left)-1.0_ldp)<=1.0e-10_ldp) weight=0.0_ldp
+        if(abs(r(k)/old_r(left+1)-1.0_ldp)<=1.0e-10_ldp) weight=1.0_ldp
+        value=0.0_ldp
+        do id=first_id,last_id
+          do j=1,atm(id)%nxzv
+            atm(id)%xzv(j,k)=interpolate_fraction(data(id)%sup(j,left)/total(left), &
+                 data(id)%sup(j,left+1)/total(left+1),weight)
+          end do
+          value=value+sum(atm(id)%xzv(:,k))
+        end do
+        atm(last_id)%dxzv(k)=interpolate_fraction(data(last_id)%ion(left)/total(left), &
+             data(last_id)%ion(left+1)/total(left+1),weight)
+        value=value+atm(last_id)%dxzv(k)
+        if(value<=0.0_ldp) call fail('zero interpolated elemental population',lu)
+        factor=pop_species(k,ispec)/value
+        do id=first_id,last_id
+          atm(id)%xzv(:,k)=atm(id)%xzv(:,k)*factor
+          ed(k)=ed(k)+(atm(id)%zxzv-1.0_ldp)*sum(atm(id)%xzv(:,k))
+          if(atm(id)%zxzv>1.01_ldp) popion(k)=popion(k)+sum(atm(id)%xzv(:,k))
+        end do
+        atm(last_id)%dxzv(k)=atm(last_id)%dxzv(k)*factor
+        ed(k)=ed(k)+atm(last_id)%zxzv*atm(last_id)%dxzv(k)
+        if(atm(last_id)%zxzv>0.01_ldp) popion(k)=popion(k)+atm(last_id)%dxzv(k)
+      end do
+    end do
+    if(any(ed<=0.0_ldp).or..not.all(ieee_is_finite(ed))) call fail('invalid interpolated charge density',lu)
+    call comp_lev_dis_blk(ed,popion,t,dissolve,n)
+    ! Distribute each interpolated superlevel over its full levels at the
+    ! target temperature, using logarithmic Boltzmann/occupation weights.
+    do id=num_ions-1,1,-1
+      if(.not.atm(id)%xzv_pres) cycle
+      nf=atm(id)%nxzv_f; ns=atm(id)%nxzv
+      allocate(weights(nf,n),group_max(ns),group_sum(ns))
+      call occupation_prob(weights,atm(id)%edgexzv_f,atm(id)%zxzv,nf,n)
+      do k=1,n
+        hdk=hdkt/t(k)
+        weights(:,k)=log(max(weights(:,k),tiny(1.0_ldp)))+log(atm(id)%gxzv_f)+hdk*atm(id)%edgexzv_f
+        group_max=-huge(1.0_ldp); group_sum=0.0_ldp
+        do j=1,nf
+          l=atm(id)%f_to_s_xzv(j)
+          group_max(l)=max(group_max(l),weights(j,k))
+        end do
+        do j=1,nf
+          l=atm(id)%f_to_s_xzv(j)
+          weights(j,k)=exp(weights(j,k)-group_max(l))
+          group_sum(l)=group_sum(l)+weights(j,k)
+        end do
+        if(any(group_sum<=0.0_ldp)) call fail('empty superlevel in POP',lu)
+        do j=1,nf
+          l=atm(id)%f_to_s_xzv(j)
+          atm(id)%xzv_f(j,k)=atm(id)%xzv(l,k)*weights(j,k)/group_sum(l)
+        end do
+      end do
+      if(atm(id+1)%xzv_pres) then
+        atm(id)%dxzv_f=atm(id+1)%xzv_f(1,:)
+      else
+        atm(id)%dxzv_f=atm(id)%dxzv
+      end if
+      deallocate(weights,group_max,group_sum)
+    end do
+    write(lu,'(A)') 'POP: interpolated source superlevel fractions; Ne set from charge conservation'
+  end subroutine
+end module
