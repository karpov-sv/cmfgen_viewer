+!
+! Evaluate the same positive log-monotone interpolation used by MOM_J_CMF.
+	SUBROUTINE MON_LOG_GRID_VALUE(Y,RSM,XSM,RF,POS,NC,NF,YF)
+	USE SET_KIND_MODULE
+	IMPLICIT NONE
+	INTEGER NC,NF,POS(NF),I,K,LU,ERROR_LU
+	EXTERNAL ERROR_LU
+	REAL(KIND=LDP) Y(NC),RSM(NC),XSM(NC),RF(NF),YF(NF)
+	REAL(KIND=LDP) COEF(NC,4),LY(NC),T1
+	IF(ANY(Y.LE.0.0_LDP))THEN
+	  LU=ERROR_LU(); WRITE(LU,*)'Nonpositive input to MON_LOG_GRID_VALUE'
+	  STOP
+	END IF
+	LY=LOG(Y)
+	CALL MON_INT_FUNS_V2(COEF,LY,XSM,NC)
+	DO I=1,NF
+	  K=POS(I); T1=LOG(RF(I)/RSM(K))
+	  YF(I)=EXP(((COEF(K,1)*T1+COEF(K,2))*T1+COEF(K,3))*T1+COEF(K,4))
+	END DO
+	END
+!
+! Piecewise derivative of MON_INT_FUNS_V2, including its Steffen slope
+! limiter. Columns are the original model values, not interpolated values.
+! At a completely flat limiter choose the zero-slope generalized derivative.
+	SUBROUTINE MON_LOG_GRID_JAC(Y,YF,RSM,XSM,RF,POS,NC,NF,P)
+	USE SET_KIND_MODULE
+	IMPLICIT NONE
+	INTEGER NC,NF,POS(NF),I,J,K,LU,ERROR_LU
+	EXTERNAL ERROR_LU
+	REAL(KIND=LDP) Y(NC),YF(NF),RSM(NC),XSM(NC),RF(NF),P(NF,NC)
+	REAL(KIND=LDP) H(NC),S(NC),D(NC),DS(NC,NC),DD(NC,NC),LY(NC)
+	REAL(KIND=LDP) A,B,C,FAC,ONE,Z,T1,WT0,WT1,WTD0,WTD1
+	ONE=1.0_LDP
+	IF(NC.LT.3 .OR. ANY(Y.LE.0.0_LDP))THEN
+	  LU=ERROR_LU(); WRITE(LU,*)'Invalid positive grid in MON_LOG_GRID_JAC'
+	  STOP
+	END IF
+	LY=LOG(Y); DS=0.0_LDP; DD=0.0_LDP
+	DO I=1,NC-1
+	  H(I)=XSM(I+1)-XSM(I)
+	  S(I)=(LY(I+1)-LY(I))/H(I)
+	  DS(I,I)=-ONE/H(I); DS(I,I+1)=ONE/H(I)
+	END DO
+	D(1)=S(1)+(S(1)-S(2))*H(1)/(H(1)+H(2))
+	DD(1,:)=DS(1,:)+(DS(1,:)-DS(2,:))*H(1)/(H(1)+H(2))
+	DO I=2,NC-1
+	  D(I)=(S(I-1)*H(I)+S(I)*H(I-1))/(H(I-1)+H(I))
+	  DD(I,:)=(DS(I-1,:)*H(I)+DS(I,:)*H(I-1))/(H(I-1)+H(I))
+	END DO
+	D(NC)=S(NC-1)+(S(NC-1)-S(NC-2))*H(NC-1)/(H(NC-2)+H(NC-1))
+	DD(NC,:)=DS(NC-1,:)+(DS(NC-1,:)-DS(NC-2,:))*H(NC-1)/(H(NC-2)+H(NC-1))
+	DO I=1,NC
+	  IF(I.EQ.1 .OR. I.EQ.NC)THEN
+	    K=1
+	    IF(I.EQ.NC)K=NC-1
+	    FAC=SIGN(ONE,S(K))+SIGN(ONE,D(I)); A=ABS(S(K)); C=0.5_LDP*ABS(D(I))
+	    IF(A.EQ.0.0_LDP .AND. C.EQ.0.0_LDP)THEN
+	      DD(I,:)=0.0_LDP
+	    ELSE IF(A.LE.C)THEN
+	      DD(I,:)=FAC*SIGN(ONE,S(K))*DS(K,:)
+	    ELSE
+	      DD(I,:)=FAC*0.5_LDP*SIGN(ONE,D(I))*DD(I,:)
+	    END IF
+	  ELSE
+	    FAC=SIGN(ONE,S(I-1))+SIGN(ONE,S(I))
+	    A=ABS(S(I-1)); B=ABS(S(I)); C=0.5_LDP*ABS(D(I))
+	    IF(FAC.EQ.0.0_LDP .OR. MAX(A,B,C).EQ.0.0_LDP)THEN
+	      DD(I,:)=0.0_LDP
+	    ELSE IF(A.LE.B .AND. A.LE.C)THEN
+	      DD(I,:)=FAC*SIGN(ONE,S(I-1))*DS(I-1,:)
+	    ELSE IF(B.LE.C)THEN
+	      DD(I,:)=FAC*SIGN(ONE,S(I))*DS(I,:)
+	    ELSE
+	      DD(I,:)=FAC*0.5_LDP*SIGN(ONE,D(I))*DD(I,:)
+	    END IF
+	  END IF
+	END DO
+	P=0.0_LDP
+	DO I=1,NF
+	  K=POS(I)
+! Model nodes have an exact single-column response. Avoid spurious
+! roundoff-size couplings from evaluating the endpoint cubic at Z~1.
+	  IF(RF(I).EQ.RSM(K))THEN
+	    P(I,K)=YF(I)/Y(K)
+	    CYCLE
+	  ELSE IF(RF(I).EQ.RSM(K+1))THEN
+	    P(I,K+1)=YF(I)/Y(K+1)
+	    CYCLE
+	  END IF
+	  T1=LOG(RF(I)/RSM(K)); Z=T1/H(K)
+	  WT0=2*Z**3-3*Z**2+ONE; WT1=-2*Z**3+3*Z**2
+	  WTD0=(Z**3-2*Z**2+Z)*H(K); WTD1=(Z**3-Z**2)*H(K)
+	  P(I,:)=WTD0*DD(K,:)+WTD1*DD(K+1,:)
+	  P(I,K)=P(I,K)+WT0; P(I,K+1)=P(I,K+1)+WT1
+	  DO J=MAX(1,K-1),MIN(NC,K+2)
+	    P(I,J)=P(I,J)*YF(I)/Y(J)
+	  END DO
+	END DO
+	END
+!
+! Differentiate the actual NORDTAU/DERIVCHI quadrature on the fine grid.
+! The legacy three-diagonal approximation omits boundary slope dependencies
+! and uses approximate limiter switches. Both refined and ordinary callers
+! now use this entry, retaining all dependencies including endpoints.
+	SUBROUTINE MOM_GRID_DTAU_JAC(CHI,Q,R,N,METHOD,P)
+	USE SET_KIND_MODULE
+	IMPLICIT NONE
+	INTEGER N,I,J,K,LU,ERROR_LU
+	EXTERNAL ERROR_LU
+	CHARACTER(LEN=*) METHOD
+	REAL(KIND=LDP) CHI(N),Q(N),R(N),P(N,N),Y(N),H(N),S(N),D(N)
+	REAL(KIND=LDP) DS(N,N),DD(N,N),A,B,C,FAC,ONE,T1,T2,ALPHA,BETA
+	LOGICAL LIMITED
+	ONE=1.0_LDP; Y=CHI*Q; DS=0.0_LDP; DD=0.0_LDP; D=0.0_LDP
+	LIMITED=METHOD.EQ.'LOGMON' .OR. METHOD.EQ.'LINMON'
+	IF(METHOD.EQ.'LOGMON' .OR. METHOD.EQ.'LINMON')THEN
+	  DO I=1,N-1
+	    IF(METHOD.EQ.'LOGMON')THEN
+	      H(I)=LOG(R(I+1)/R(I)); S(I)=LOG(Y(I+1)/Y(I))/H(I)
+	      DS(I,I)=-ONE/H(I)/Y(I); DS(I,I+1)=ONE/H(I)/Y(I+1)
+	    ELSE
+	      H(I)=R(I+1)-R(I); S(I)=(Y(I+1)-Y(I))/H(I)
+	      DS(I,I)=-ONE/H(I); DS(I,I+1)=ONE/H(I)
+	    END IF
+	  END DO
+	  D(1)=S(1)+(S(1)-S(2))*H(1)/(H(1)+H(2))
+	  DD(1,:)=DS(1,:)+(DS(1,:)-DS(2,:))*H(1)/(H(1)+H(2))
+	  DO I=2,N-1
+	    D(I)=(S(I-1)*H(I)+S(I)*H(I-1))/(H(I-1)+H(I))
+	    DD(I,:)=(DS(I-1,:)*H(I)+DS(I,:)*H(I-1))/(H(I-1)+H(I))
+	  END DO
+	  D(N)=S(N-1)+(S(N-1)-S(N-2))*H(N-1)/(H(N-2)+H(N-1))
+	  DD(N,:)=DS(N-1,:)+(DS(N-1,:)-DS(N-2,:))*H(N-1)/(H(N-2)+H(N-1))
+	  IF(METHOD.EQ.'LOGMON')THEN
+	    DO I=1,N
+	      DD(I,:)=DD(I,:)*Y(I)/R(I)
+	      DD(I,I)=DD(I,I)+D(I)/R(I)
+	      D(I)=D(I)*Y(I)/R(I)
+	    END DO
+	  END IF
+! Native limiter is applied in linear opacity/radius coordinates.
+	  DS=0.0_LDP
+	  DO I=1,N-1
+	    H(I)=R(I+1)-R(I); S(I)=(Y(I+1)-Y(I))/H(I)
+	    DS(I,I)=-ONE/H(I); DS(I,I+1)=ONE/H(I)
+	  END DO
+	  DO I=1,N
+	    IF(I.EQ.1 .OR. I.EQ.N)THEN
+	      K=1
+	      IF(I.EQ.N)K=N-1
+	      FAC=SIGN(ONE,S(K))+SIGN(ONE,D(I)); A=ABS(S(K)); C=0.5_LDP*ABS(D(I))
+	      IF(MAX(A,C).EQ.0.0_LDP)THEN
+	        DD(I,:)=0.0_LDP
+	      ELSE IF(A.LE.C)THEN
+	        DD(I,:)=FAC*SIGN(ONE,S(K))*DS(K,:)
+	      ELSE
+	        DD(I,:)=FAC*0.5_LDP*SIGN(ONE,D(I))*DD(I,:)
+	      END IF
+	    ELSE
+	      FAC=SIGN(ONE,S(I-1))+SIGN(ONE,S(I))
+	      A=ABS(S(I-1)); B=ABS(S(I)); C=0.5_LDP*ABS(D(I))
+	      IF(FAC.EQ.0.0_LDP .OR. MAX(A,B,C).EQ.0.0_LDP)THEN
+	        DD(I,:)=0.0_LDP
+	      ELSE IF(A.LE.B .AND. A.LE.C)THEN
+	        DD(I,:)=FAC*SIGN(ONE,S(I-1))*DS(I-1,:)
+	      ELSE IF(B.LE.C)THEN
+	        DD(I,:)=FAC*SIGN(ONE,S(I))*DS(I,:)
+	      ELSE
+	        DD(I,:)=FAC*0.5_LDP*SIGN(ONE,D(I))*DD(I,:)
+	      END IF
+	    END IF
+	  END DO
+	ELSE IF(METHOD(1:4).EQ.'ZERO')THEN
+	  DD=0.0_LDP
+	ELSE IF(METHOD.EQ.'LINEAR' .OR. METHOD.EQ.'LOGLIN' .OR. METHOD.EQ.'LOGLOG')THEN
+	  DO I=1,N
+	    K=MAX(1,I-1); J=MIN(N,I+1)
+	    IF(I.EQ.2 .AND. (R(1)-R(3))/(R(1)-R(2)).GT.3.0_LDP)THEN
+	      K=1; J=2
+	    END IF
+	    IF(I.EQ.N-1 .AND. (R(N-2)-R(N))/(R(N-1)-R(N)).GT.3.0_LDP)THEN
+	      K=N-1; J=N
+	    END IF
+	    T1=R(K)-R(J)
+	    IF(METHOD.EQ.'LOGLOG')T1=LOG(R(K)/R(J))
+	    IF(METHOD.EQ.'LINEAR')THEN
+	      DD(I,K)=ONE/T1; DD(I,J)=-ONE/T1
+	    ELSE
+	      T2=Y(I)
+	      IF(METHOD.EQ.'LOGLOG')T2=Y(I)/R(I)
+	      DD(I,K)=T2/T1/Y(K); DD(I,J)=-T2/T1/Y(J)
+	      DD(I,I)=DD(I,I)+LOG(Y(K)/Y(J))*T2/T1/Y(I)
+	    END IF
+	  END DO
+	ELSE
+	  LU=ERROR_LU(); WRITE(LU,*)'Unknown optical-depth method in MOM_GRID_DTAU_JAC: ',METHOD
+	  STOP
+	END IF
+	P=0.0_LDP
+	DO I=1,N-1
+	  ALPHA=0.5_LDP*(R(I)-R(I+1)); BETA=ALPHA*(R(I)-R(I+1))/6.0_LDP
+	  P(I,:)=BETA*(DD(I+1,:)-DD(I,:))*Q
+	  P(I,I)=P(I,I)+ALPHA*Q(I); P(I,I+1)=P(I,I+1)+ALPHA*Q(I+1)
+	END DO
+	END
+
+! Derivative of MON_INTERP(log(Y), R) for relativistic transport.
+	SUBROUTINE MON_LINEAR_LOG_GRID_JAC(Y,YF,RSM,XSM,RF,POS,NC,NF,P)
+	USE SET_KIND_MODULE
+	IMPLICIT NONE
+	INTEGER NC,NF,POS(NF),I,J,K,LU,ERROR_LU
+	EXTERNAL ERROR_LU
+	REAL(KIND=LDP) Y(NC),YF(NF),RSM(NC),XSM(NC),RF(NF),P(NF,NC)
+	REAL(KIND=LDP) H(NC),S(NC),D(NC),DS(NC,NC),DD(NC,NC),LY(NC)
+	REAL(KIND=LDP) A,B,C,FAC,ONE,Z,T1,WT0,WT1,WTD0,WTD1
+	ONE=1.0_LDP
+	IF(NC.LT.3 .OR. ANY(Y.LE.0.0_LDP))THEN
+	  LU=ERROR_LU(); WRITE(LU,*)'Invalid positive grid in MON_LOG_GRID_JAC'
+	  STOP
+	END IF
+	LY=LOG(Y); DS=0.0_LDP; DD=0.0_LDP
+	DO I=1,NC-1
+	  H(I)=XSM(I+1)-XSM(I)
+	  S(I)=(LY(I+1)-LY(I))/H(I)
+	  DS(I,I)=-ONE/H(I); DS(I,I+1)=ONE/H(I)
