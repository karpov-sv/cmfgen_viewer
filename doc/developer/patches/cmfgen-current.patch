+	D(1)=S(1)+(S(1)-S(2))*H(1)/(H(1)+H(2))
+	DD(1,:)=DS(1,:)+(DS(1,:)-DS(2,:))*H(1)/(H(1)+H(2))
+	DO I=2,NC-1
+	  D(I)=(S(I-1)*H(I)+S(I)*H(I-1))/(H(I-1)+H(I))
+	  DD(I,:)=(DS(I-1,:)*H(I)+DS(I,:)*H(I-1))/(H(I-1)+H(I))
+	END DO
+	D(NC)=S(NC-1)+(S(NC-1)-S(NC-2))*H(NC-1)/(H(NC-2)+H(NC-1))
+	DD(NC,:)=DS(NC-1,:)+(DS(NC-1,:)-DS(NC-2,:))*H(NC-1)/(H(NC-2)+H(NC-1))
+	DO I=1,NC
+	  IF(I.EQ.1 .OR. I.EQ.NC)THEN
+	    K=1
+	    IF(I.EQ.NC)K=NC-1
+	    FAC=SIGN(ONE,S(K))+SIGN(ONE,D(I)); A=ABS(S(K)); C=0.5_LDP*ABS(D(I))
+	    IF(A.EQ.0.0_LDP .AND. C.EQ.0.0_LDP)THEN
+	      DD(I,:)=0.0_LDP
+	    ELSE IF(A.LE.C)THEN
+	      DD(I,:)=FAC*SIGN(ONE,S(K))*DS(K,:)
+	    ELSE
+	      DD(I,:)=FAC*0.5_LDP*SIGN(ONE,D(I))*DD(I,:)
+	    END IF
+	  ELSE
+	    FAC=SIGN(ONE,S(I-1))+SIGN(ONE,S(I))
+	    A=ABS(S(I-1)); B=ABS(S(I)); C=0.5_LDP*ABS(D(I))
+	    IF(FAC.EQ.0.0_LDP .OR. MAX(A,B,C).EQ.0.0_LDP)THEN
+	      DD(I,:)=0.0_LDP
+	    ELSE IF(A.LE.B .AND. A.LE.C)THEN
+	      DD(I,:)=FAC*SIGN(ONE,S(I-1))*DS(I-1,:)
+	    ELSE IF(B.LE.C)THEN
+	      DD(I,:)=FAC*SIGN(ONE,S(I))*DS(I,:)
+	    ELSE
+	      DD(I,:)=FAC*0.5_LDP*SIGN(ONE,D(I))*DD(I,:)
+	    END IF
+	  END IF
+	END DO
+	P=0.0_LDP
+	DO I=1,NF
+	  K=POS(I)
+! Model nodes have an exact single-column response. Avoid spurious
+! roundoff-size couplings from evaluating the endpoint cubic at Z~1.
+	  IF(RF(I).EQ.RSM(K))THEN
+	    P(I,K)=YF(I)/Y(K)
+	    CYCLE
+	  ELSE IF(RF(I).EQ.RSM(K+1))THEN
+	    P(I,K+1)=YF(I)/Y(K+1)
+	    CYCLE
+	  END IF
+	  T1=RF(I)-RSM(K); Z=T1/H(K)
+	  WT0=2*Z**3-3*Z**2+ONE; WT1=-2*Z**3+3*Z**2
+	  WTD0=(Z**3-2*Z**2+Z)*H(K); WTD1=(Z**3-Z**2)*H(K)
+	  P(I,:)=WTD0*DD(K,:)+WTD1*DD(K+1,:)
+	  P(I,K)=P(I,K)+WT0; P(I,K+1)=P(I,K+1)+WT1
+	  DO J=MAX(1,K-1),MIN(NC,K+2)
+	    P(I,J)=P(I,J)*YF(I)/Y(J)
+	  END DO
+	END DO
+	END
+! Compose the actual EXTEND3OPAC log-value map with internal moment insertion.
+	SUBROUTINE BUILD_EXTENDED_MOM_JAC(CM,EM,SM,CE,EE,SE,RE,JE,COEF,INDX,NC,NE,COHERENT)
+	USE SET_KIND_MODULE
+	USE MOD_MOM_J_V11, ONLY: NF=>ND,RF=>R,CF=>CHI,SF=>ESEC,R_PNT,LOG_R_SM,
+	1 GRID_ETA,GRID_PCHI,GRID_PETA,GRID_PESC
+	IMPLICIT NONE
+	INTEGER NC,NE,INDX(NE),I,J,K
+	REAL(KIND=LDP) CM(NC),EM(NC),SM(NC),CE(NE),EE(NE),SE(NE),RE(NE),JE(NE),COEF(0:3,NE)
+	REAL(KIND=LDP) PC(NE,NC),PE(NE,NC),PS(NE,NC),PF(NF,NE),ETOT(NE)
+	LOGICAL COHERENT
+	PC=0.0_LDP; PE=0.0_LDP; PS=0.0_LDP
+	DO I=1,NE
+	 DO J=0,3
+	  K=INDX(I)+J
+	  PC(I,K)=PC(I,K)+CE(I)*COEF(J,I)/CM(K)
+	  PE(I,K)=PE(I,K)+EE(I)*COEF(J,I)/EM(K)
+	  PS(I,K)=PS(I,K)+SE(I)*COEF(J,I)/SM(K)
+	 END DO
+	END DO
+	CALL MON_LOG_GRID_JAC(CE,CF,RE,LOG_R_SM,RF,R_PNT,NE,NF,PF)
+	GRID_PCHI=MATMUL(PF,PC)
+	ETOT=EE
+	IF(.NOT.COHERENT)ETOT=ETOT+SE*JE
+	CALL MON_LOG_GRID_VALUE(ETOT,RE,LOG_R_SM,RF,R_PNT,NE,NF,GRID_ETA)
+	CALL MON_LOG_GRID_JAC(ETOT,GRID_ETA,RE,LOG_R_SM,RF,R_PNT,NE,NF,PF)
+	GRID_PETA=MATMUL(PF,PE)
+	IF(COHERENT)THEN
+	 CALL MON_LOG_GRID_JAC(SE,SF,RE,LOG_R_SM,RF,R_PNT,NE,NF,PF)
+	ELSE
+	 DO I=1,NE
+	  PS(I,:)=PS(I,:)*JE(I)
+	 END DO
+	END IF
+	GRID_PESC=MATMUL(PF,PS)
+	END
+!
+! Fixed geometric projection for model flux locations, including odd first
+! extensions where the model midpoint is not an extended-grid midpoint.
+	SUBROUTINE MOM_MODEL_H_MAP(RM,NC,RF,NF,LEFT,RIGHT,WL,WR)
+	USE SET_KIND_MODULE
+	IMPLICIT NONE
+	INTEGER NC,NF,LEFT(NC-1),RIGHT(NC-1),I,K
+	REAL(KIND=LDP) RM(NC),RF(NF),WL(NC-1),WR(NC-1),X,A,B
+	DO I=1,NC-1
+	 X=0.5_LDP*(RM(I)+RM(I+1)); K=1
+	 DO WHILE(K.LT.NF-2)
+	  IF(X.GE.0.5_LDP*(RF(K+1)+RF(K+2)))EXIT
+	  K=K+1
+	 END DO
+	 A=0.5_LDP*(RF(K)+RF(K+1)); B=0.5_LDP*(RF(K+1)+RF(K+2))
+	 LEFT(I)=K; RIGHT(I)=K+1
+	 WL(I)=(X-B)/(A-B); WR(I)=1.0_LDP-WL(I)
+	END DO
+	END
