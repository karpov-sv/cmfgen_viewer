+	REAL(KIND=LDP) SPEED_OF_LIGHT
+	REAL(KIND=LDP) BC_TIME,BC_TAU,BC_G,BC_GP,BC_DTAU,BC_Z,BC_EXTRA
+	REAL(KIND=LDP) PCHI(ND,NC),PETA(ND,NC),PESC(ND,NC),ZERO_EPS(ND)
+	REAL(KIND=LDP) KI_MODEL(ND,NC,2),RHS_MODEL(ND-1,NC),OLD_MODEL(ND,NC)
