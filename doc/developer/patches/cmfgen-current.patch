+# Ubuntu with gfortran
+ifeq ($(COMPILE_OPT),ubuntu_gcc_nodebug)
+ F90 = gfortran -fopenmp -O -finit-local-zero
+ F90nomp = gfortran -O -finit-local-zero
+ FG  =  -ffixed-line-length-0 -fallow-argument-mismatch -fno-backslash -fd-lines-as-comments -I$(MOD_DIR) -J$(MOD_DIR)
+ FH  =  -ffixed-line-length-0 -fallow-argument-mismatch -fno-backslash -fd-lines-as-comments -I$(MOD_DIR) -J$(MOD_DIR)
