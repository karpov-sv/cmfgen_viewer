+	  ALLOCATE ( dH_OLDT(ND) )
+	  ALLOCATE ( DJDt(ND) )
+	  ALLOCATE ( DJDt_OLDT(ND) )
+	  ALLOCATE ( DTAU(ND) )
+	  ALLOCATE ( DUMMY_VEC(ND) )
+	  ALLOCATE ( HU(ND) )
+	  ALLOCATE ( HL(ND) )
+	  ALLOCATE ( HS(ND) )
+	  ALLOCATE ( HT(ND) )
+	  ALLOCATE ( GAM(ND) )
+	  ALLOCATE ( GAMH(ND) )
+	  ALLOCATE ( PSI(ND) )
+	  ALLOCATE ( PSIPREV(ND) )
+	  ALLOCATE ( Q(ND) )
+	  ALLOCATE ( RSQ_DTAUONQ(ND) )
+	  ALLOCATE ( SOURCE(ND) )
+	  ALLOCATE ( TA(ND) )
+	  ALLOCATE ( TB(ND) )
+	  ALLOCATE ( TC(ND) )
+	  ALLOCATE ( TX_OLD_d_T(ND) )
+	  ALLOCATE ( TX_OLD_d_dTdR(ND) )
+	  ALLOCATE ( VB(ND) )
+	  ALLOCATE ( VC(ND) )
