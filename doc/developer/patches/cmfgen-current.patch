+
+! Rectangular time-dependent response, retaining the actual moment grid.
+	SUBROUTINE VAR_MOM_J_DDT_GRID_V1(ETA,CHI,ESEC,THETA,V,R,
+	1                  TX,TVX,TX_DIF_d_T,TX_DIF_d_dTdR,
+	1                  TVX_DIF_d_T,TVX_DIF_d_dTdR,
+	1                  KI,WORKMAT,RHS_dHdCHI,F,
