+
+! Refined moment-grid operator with MODEL parameter columns.
+	SUBROUTINE VAR_MOM_J_GRID_V1(ETA,CHI,ESEC,THETA,V,SIGMA,R,
+	1               TX,TVX,TX_DIF_d_T,TX_DIF_d_dTdR,
+	1               TVX_DIF_d_T,TVX_DIF_d_dTdR,
+	1               KI,WORKMAT,RHS_dHdCHI,
+	1               INIT,dLOG_NU,
+	1               INNER_BND_METH,dTdR,DBB,dDBBdT,IC,IB_STAB_FACTOR,
+	1               FREQ,H_CHK_OPTION,OUT_BC_TYPE,
+	1               DO_THIS_TX_MATRIX,METHOD,ND,NC,NM,NM_KI,
+	1               PCHI,PETA,PESC,R_PNT,ESC_RESPONSE,ESC_H)
+	USE SET_KIND_MODULE
+	USE MOD_RAY_MOM_STORE
+	USE MOD_VAR_MOM_J_CMF
+	IMPLICIT NONE
+!
+! Altered:   11-Jun-2109 : Added point source option.
+! Altered:   17-Oct-2016 : Changed to V12: CHECK_H_ON J replaced by H_CHK_OPTION.
+! Altered:   17-Feb-2016 : Changed to V11. DIF replaced by INNER_BND_METH and
+!                            IB_STAB_FACTOR added.
+! Altered:   24-Feb-2015 : Added CHECK_H_ON_J to call.
+! Altered:   06-Aug-2007 : Installed integer OUT_BC_TYPE
+!                            so that could have choice of boundary conditions
+!                            This allows other options to be included.
+! Altered:   04-Feb-1997 : THETA now passed. Passed to allow coherent
+!                            scattering at some depths, and non-coherent
+!                            scattering at other depths. Only introduced
+!                            for the variation calculation. Logical variable
+!                            COHERENT no longer required.
+! Altered:   12-Dec-1996 : NM_KI installed. Changed to version V6.
+! Altered:   05-Dec-1996 : PROGDESC set to REAL(KIND=LDP) value, PROG_ID installed
+!                             ERROR_LU installed. TUNE installed.
+! Altered:   25-Jan-1996 : HBC, NBC (and HBC_PREV, NBC_PREV) are now
+!                            scalers. Other quantities were not needed
+!                            with THK option processed by EXTENSION.
+!                            Several lines deleted with HBC(2) etc.
+!                          Changed to V5
+!
+! Altered:   11-Jan-1996 : Bug in calculation of DT_DIF_d_dTDR when using
+!                             RSQN_ON_RSQJ. Initiliazation improved.
+
+! Altered:   11-Mar-1995 : RSQN_ON_RSQJ installed so that N may be written in
+!                          terms of H (using G) or J.
+!                          Call modified, as were subroutines UP_TX_TVX and
+!                          EDD_J_VAR.
+!                          _V4 append to name.
+!
+! Finalized: 04-Nov-1994
+! Created:   27-Sep-1995 : Diffusion approximation not tested yet.
+!
+	INTEGER ND,NC
+	INTEGER NM
+	INTEGER NM_KI
+	REAL(KIND=LDP) ETA(ND),CHI(ND),ESEC(ND),THETA(ND)
+	REAL(KIND=LDP) V(ND),SIGMA(ND),R(ND)
+!
+! Variation arrays and vectors.
+!
+	REAL(KIND=LDP) TX(ND,NC,NM),TVX(ND-1,NC,NM)
+	REAL(KIND=LDP) KI(ND,ND,NM_KI)
+	REAL(KIND=LDP) PCHI(ND,NC),PETA(ND,NC),PESC(ND,NC)
+	REAL(KIND=LDP) KI_MODEL(ND,NC,2),RHS_MODEL(ND-1,NC),OLD_MODEL(ND,NC)
+	REAL(KIND=LDP) ESC_RESPONSE(ND,NC),ESC_H(ND-1,NC)
+	INTEGER R_PNT(ND),JF,JM,IR
+	REAL(KIND=LDP) WORKMAT(ND,ND),RHS_dHdCHI(ND-1,ND)
+	REAL(KIND=LDP) TX_DIF_d_T(ND),TX_DIF_d_dTdR(ND)
+	REAL(KIND=LDP) TVX_DIF_d_T(ND),TVX_DIF_d_dTdR(ND)
+!
+	LOGICAL DO_THIS_TX_MATRIX(NM)
+!
+	REAL(KIND=LDP) dLOG_NU,dTdR,DBB,dDBBdT,IC
+	REAL(KIND=LDP) FREQ
+	REAL(KIND=LDP) IB_STAB_FACTOR
+	CHARACTER*6 METHOD
+!
+! INIT is used to indicate that there is no coupling to the previous frequency.
+! We are thus solving the normal continuum transfer equation (i.e. the absence
+! of velocity fields)
+!
+	LOGICAL INIT
+	INTEGER OUT_BC_TYPE
+	CHARACTER(LEN=*) INNER_BND_METH
+	CHARACTER(LEN=*) H_CHK_OPTION
+!
+	REAL(KIND=LDP) T1
+	REAL(KIND=LDP) DTAU_BND
+!
+	INTEGER ERROR_LU
+	EXTERNAL ERROR_LU
+!
+! Local variables.
+!
+	INTEGER I
+	REAL(KIND=LDP) AV_SIGMA
+	REAL(KIND=LDP) LOCAL_DBB
+	LOGICAL COHERENT_RESPONSE
+	LOGICAL DIF_OR_ZF
+! Keep the raw solution for -dA/dchi*J; repaired values feed H and history.
+        REAL(KIND=LDP) J_USED(ND),J_FACTOR(ND),H_DJL(ND-1),H_DJR(ND-1)
+        LOGICAL H_LIMITED(ND-1),LIMIT_ACTIVE
+        INTEGER LIM_J,LIM_K
+
+!
+! 
+!
+! This call allocates the vectors, and initialzes vectors such as TA etc.
+! It only allocates TA, if it is not already allocated.
+!
+	CALL MOD_VAR_MOM_ALLOC(ND)
+!
+	IF(INIT)THEN
+	  CALL DP_ZERO(TX, ND*NC*NM )
+	  CALL DP_ZERO(TVX, (ND-1)*NC*NM )
+	  IF(ALLOCATED(TA))THEN
+	    IF(ND .NE. VEC_LENGTH)THEN
+	      I=ERROR_LU()
+	      WRITE(I,*)'Problem in VAR_MOM_J_CMF_V9'
+	      WRITE(I,*)'Incompatible vector size'
+	      WRITE(I,*)'ND=',ND,'ND(vec_size)=',VEC_LENGTH
+	      STOP
+	    END IF
+	  END IF
+	  DO I=1,ND
+	    JNUM1(I)=0.0_LDP
+	    RSQ_HNUM1(I)=0.0_LDP
+ 	  END DO
+	END IF
+!
+! Zero relevant vectors and matrices.
+!
+	DO I=1,ND
+	  JNU(I)=0.0_LDP
+	  RSQ_HNU(I)=0.0_LDP
+	END DO
+!
+	DO I=1,ND
+	  SOURCE(I)=ETA(I)/CHI(I)
+	END DO
+!
+! Compute the Q factors from F. Then compute optical depth scale.
+!
+	CALL QFROMF(K_ON_J,Q,R,TA,TB,ND)	!TA work vector
+	DO I=1,ND
+	  TA(I)=CHI(I)*Q(I)
+	END DO
+	CALL DERIVCHI(TB,TA,R,ND,METHOD)
+!
+! We need to call d_DERIVCHI_dCHI to set the TRAP derivatives.
+!
+! The refined-grid EDD entry consumes the full quadrature Jacobian below.
+	CALL NORDTAU(DTAU,TA,R,R,TB,ND)
+	DO I=2,ND
+	  RSQ_DTAUONQ(I)=0.5_LDP*R(I)*R(I)*(DTAU(I)+DTAU(I-1))/Q(I)
+	END DO
+!
+! 
+!
+! Assume (1)	SIGMAd+1/2 = 0.5*( SIGMAd+1+SIGMAd )
+! 	 (2)	Vd+1/2=0.5*( Vd + Vd+1 )
+! Note that V is in km/s and SIGMA=(dlnV/dlnR-1.0)
+!
+! NB - By definition, G is defined at the mesh midpoints.
+!
+! We evaluate and store the constant terms in the computation of GAMH and
+! GAM, since number of operations only proportional to ND. Later on scaling is
+! proportional to NM*ND*ND.
+!
+	IF(.NOT. INIT)THEN
+	  DO I=1,ND-1
+	    AV_SIGMA=0.5_LDP*(SIGMA(I)+SIGMA(I+1))
+	    GAMH(I)=2.0_LDP*3.33564E-06_LDP*(V(I)+V(I+1))/(R(I)+R(I+1))
+	1         /dLOG_NU/( CHI(I)+CHI(I+1) )
+	    W(I)=GAMH(I)*( 1.0_LDP+AV_SIGMA*NMID_ON_HMID(I) )
+	    WPREV(I)=GAMH(I)*( 1.0_LDP+AV_SIGMA*NMID_ON_HMID_PREV(I) )
+	    EPS_A(I)=GAMH(I)*AV_SIGMA*NMID_ON_J(I)/(1.0_LDP+W(I))
+	    EPS_B(I)=EPS_A(I)*R(I+1)*R(I+1)
+	    EPS_A(I)=EPS_A(I)*R(I)*R(I)
+	    EPS_PREV_A(I)=GAMH(I)*AV_SIGMA*NMID_ON_J_PREV(I)/(1.0_LDP+W(I))
+	    EPS_PREV_B(I)=EPS_PREV_A(I)*R(I+1)*R(I+1)
+	    EPS_PREV_A(I)=EPS_PREV_A(I)*R(I)*R(I)
+	  END DO
+	  DO I=1,ND
+	    GAM(I)=3.33564E-06_LDP*V(I)/R(I)/CHI(I)/dLOG_NU
+	  END DO
+!
+! PSIPREV is equivalent to the U vector of FORMSOL.
+!
+	  DO I=2,ND
+	    PSI(I)=RSQ_DTAUONQ(I)*GAM(I)*( 1.0_LDP+SIGMA(I)*K_ON_J(I) )
+	    PSIPREV(I)=RSQ_DTAUONQ(I)*GAM(I)*( 1.0_LDP+SIGMA(I)*K_ON_J_PREV(I) )
+	  END DO
+	END IF
+!
+! 
+!
+! Compute vectors used to compute the flux vector H.
+!
+	DO I=1,ND-1
+	  HU(I)=R(I+1)*R(I+1)*K_ON_J(I+1)*Q(I+1)/(1.0_LDP+W(I))/DTAU(I)
+	  HL(I)=R(I)*R(I)*K_ON_J(I)*Q(I)/(1.0_LDP+W(I))/DTAU(I)
+	  HS(I)=WPREV(I)/(1.0_LDP+W(I))
+	END DO
+!
+! Compute the TRIDIAGONAL operators, and the RHS source vector.
+!
+	DO I=2,ND-1
+	  TA(I)=-HL(I-1)-EPS_A(I-1)
+	  TC(I)=-HU(I)+EPS_B(I)
+	  TB(I)=RSQ_DTAUONQ(I)*(1.0_LDP-THETA(I)) + PSI(I) +HU(I-1) +HL(I)
+	1             -EPS_B(I-1)+EPS_A(I)
+	  VB(I)=-HS(I-1)
+	  VC(I)=HS(I)
+	  XM(I)=RSQ_DTAUONQ(I)*SOURCE(I)
+	END DO
+!
+! Evaluate TA,TB,TC for boundary conditions
+!
+	IF(OUT_BC_TYPE .LE. 1)THEN
+	  PSI(1)=R(1)*R(1)*GAM(1)*( HBC+NBC*SIGMA(1) )
+	  PSIPREV(1)=R(1)*R(1)*GAM(1)*( HBC_PREV+NBC_PREV*SIGMA(1) )
+	  TC(1)=-R(2)*R(2)*K_ON_J(2)*Q(2)/DTAU(1)
+	  TB(1)=R(1)*R(1)*( K_ON_J(1)*Q(1)/DTAU(1) + HBC ) + PSI(1)
+	  XM(1)=XM(1) + PSIPREV(1)*JNUM1(1)
+	  TA(1)=0.0_LDP
+	  VB(1)=0.0_LDP
+	  VC(1)=0.0_LDP
+	ELSE
+	  PSI(1)=R(1)*R(1)*GAM(1)*(1.0_LDP+SIGMA(1)*K_ON_J(1))
+	  PSIPREV(1)=R(1)*R(1)*GAM(1)*(1.0_LDP+SIGMA(1)*K_ON_J_PREV(1))
+	  T1=0.25_LDP*(CHI(2)+CHI(1))*(R(2)-R(1))
+	  DTAU_BND=T1
+	  TC(1)=(HU(1)-EPS_B(1))/T1
+	  TB(1)=-(HL(1)+R(1)*R(1)*HBC+EPS_A(1))/T1-PSI(1)-R(1)*R(1)*(1.0_LDP-THETA(1))
+	  XM(1)=-SOURCE(1)*R(1)*R(1)- HS(1)*RSQ_HNUM1(1)/T1- PSIPREV(1)*JNUM1(1)
+	  XM(1)=XM(1)-(EPS_PREV_A(1)*JNUM1(1)+EPS_PREV_B(1)*JNUM1(2))/T1
+	END IF
+!
+	TA(ND)=-R(ND-1)*R(ND-1)*K_ON_J(ND-1)*Q(ND-1)/DTAU(ND-1)
+	IF(INNER_BND_METH .EQ. 'DIFFUSION')THEN
+	  TB(ND)=R(ND)*R(ND)*K_ON_J(ND)/DTAU(ND-1)
+	  XM(ND)=DBB*R(ND)*R(ND)/3.0_LDP/CHI(ND)
+	  LOCAL_DBB=DBB
+	  DIF_OR_ZF=.TRUE.
+	ELSE IF(INNER_BND_METH .EQ. 'PNT_SRCE')THEN
+	  TB(ND)=R(ND)*R(ND)*K_ON_J(ND)/DTAU(ND-1)
+	  XM(ND)=HNU_AT_IB*R(ND)*R(ND)
+	  LOCAL_DBB=HNU_AT_IB                     !Not used
+	  DIF_OR_ZF=.FALSE.
+	ELSE IF(INNER_BND_METH .EQ. 'ZERO_FLUX')THEN
+	  TB(ND)=R(ND)*R(ND)*K_ON_J(ND)/DTAU(ND-1)
+	  XM(ND)=IB_STAB_FACTOR*TB(ND)*R(ND)*R(ND)*(JPLUS_IB+JMIN_IB)
+	  TB(ND)=(1.0_LDP+IB_STAB_FACTOR)*TB(ND)
+	  LOCAL_DBB=0.0_LDP
+	  DIF_OR_ZF=.FALSE.
+	ELSE IF(INNER_BND_METH .EQ. 'SCHUSTER')THEN
+	  TB(ND)=R(ND)*R(ND)*K_ON_J(ND)/DTAU(ND-1)+IN_HBC
+	  XM(ND)=R(ND)*R(ND)*IC*(0.25_LDP+0.5_LDP*IN_HBC)
+	  DIF_OR_ZF=.FALSE.
+	END IF
+	TC(ND)=0.0_LDP
+	VB(ND)=0.0_LDP
+	VC(ND)=0.0_LDP
+	PSIPREV(ND)=0.0_LDP
+!
+! We create PSIPREV_MOD to save multiplications in the UP_TX_TVX routine/
+! It is only different from PSIPREV when N_ON_J is non zero.
+!
+	PSIPREV_MOD(1)=PSIPREV(1)
+	PSIPREV_MOD(ND)=PSIPREV(ND)
+	DO I=2,ND-1
+	  PSIPREV_MOD(I)=(EPS_PREV_A(I)-EPS_PREV_B(I-1)) + PSIPREV(I)
+	END DO
+!
+	DO I=2,ND-1
+	  XM(I)=XM(I) + VB(I)*RSQ_HNUM1(I-1) + VC(I)*RSQ_HNUM1(I)
+	1          + PSIPREV_MOD(I)*JNUM1(I)
+	1          + ( EPS_PREV_B(I)*JNUM1(I+1) - EPS_PREV_A(I-1)*JNUM1(I-1) )
+	END DO
+	XM(ND)=XM(ND) + PSIPREV_MOD(ND)*JNUM1(ND)
+!
+! Solve for the radiation field along ray for this frequency.
+!
+	CALL THOMAS(TA,TB,TC,XM,ND,1)
+!
+	DO I=1,ND
+	  JNU(I)=XM(I)
+	END DO
+!
+! Match the forward abs(J)/10 repair BEFORE constructing/capping H.
+        CALL MOM_JH_LIMIT_STATE(JNU,J_USED,J_FACTOR,RSQ_HNU,
+     1       H_LIMITED,H_DJL,H_DJR,R,HU,HL,HS,EPS_A,EPS_B,
+     1       EPS_PREV_A,EPS_PREV_B,JNUM1,RSQ_HNUM1,H_CHK_OPTION,ND)
+        LIMIT_ACTIVE=ANY(J_FACTOR.NE.1.0_LDP).OR.ANY(H_LIMITED)
+!
+! The J and H components of the radiation field have been found. We can thus
+! begin the variation computation.
+!
+! Compute d{non-radiation field}/dchi matrix.
+!
+	CALL TUNE(1,'MOM_EDD')
+	CALL MOM_GRID_DTAU_JAC(CHI,Q,R,ND,METHOD,WORKMAT)
+	CALL EDD_J_VAR_GRID_V1(KI,RHS_dHdCHI,WORKMAT,
+	1           SOURCE,CHI,ESEC,THETA,DTAU,R,SIGMA,
+	1           K_ON_J,Q,HU,HL,HS,RSQ_DTAUONQ,
+	1           W,WPREV,PSI,PSIPREV,
+	1           EPS_A,EPS_B,EPS_PREV_A,EPS_PREV_B,
+	1           JNU,JNUM1,RSQ_HNUM1,
+	1           LOCAL_DBB,DIF_OR_ZF,HBC,OUT_BC_TYPE,
+	1           ND,NM_KI)
+	CALL TUNE(2,'MOM_EDD')
+! ZERO_FLUX stabilizer multiplies both the boundary diagonal and source.
+! Its opacity derivative must use the same factor as the forward equation.
+	IF(INNER_BND_METH .EQ. 'ZERO_FLUX')THEN
+	  T1=IB_STAB_FACTOR*R(ND)*R(ND)*K_ON_J(ND)/DTAU(ND-1)**2
+	1      *(JNU(ND)-R(ND)*R(ND)*(JPLUS_IB+JMIN_IB))
+	  KI(ND,:,1)=KI(ND,:,1)+T1*WORKMAT(ND-1,:)
+	END IF
+
+! Only the H coefficient partial uses repaired J. The matrix partial above
+! must retain raw J. WORKMAT still contains the exact dTAU/dCHI here.
+        IF(ANY(J_FACTOR.NE.1.0_LDP))THEN
+          CALL MOM_JH_CHI_CORRECTION(RHS_dHdCHI,J_USED-JNU,
+     1        WORKMAT,CHI,DTAU,HU,HL,W,EPS_A,EPS_B,ND)
+        END IF
+
+! Chain fine-grid opacity/emissivity partials to MODEL variables using the
+! derivative of the same Steffen log-radius/log-value interpolation.
+	COHERENT_RESPONSE=ANY(THETA.NE.0.0_LDP)
+	KI_MODEL=0.0_LDP; RHS_MODEL=0.0_LDP; ESC_RESPONSE=0.0_LDP
+	DO JF=1,ND
+	  DO JM=1,NC
+! Interpolation rows have local support. Preserve the nonzero summation
+! order while avoiding products whose three model-grid weights vanish.
+            IF(PCHI(JF,JM).EQ.0.0_LDP .AND. PETA(JF,JM).EQ.0.0_LDP
+     1           .AND. PESC(JF,JM).EQ.0.0_LDP)CYCLE
+	    DO IR=1,ND
+	      KI_MODEL(IR,JM,1)=KI_MODEL(IR,JM,1)+KI(IR,JF,1)*PCHI(JF,JM)
+	      KI_MODEL(IR,JM,2)=KI_MODEL(IR,JM,2)+KI(IR,JF,2)*PETA(JF,JM)
+	      IF(COHERENT_RESPONSE)THEN
+	      ESC_RESPONSE(IR,JM)=ESC_RESPONSE(IR,JM)+KI(IR,JF,2)*JNU(JF)*PESC(JF,JM)
+	    ELSE
+	      ESC_RESPONSE(IR,JM)=ESC_RESPONSE(IR,JM)+KI(IR,JF,2)*PESC(JF,JM)
+	    END IF
+	    END DO
+	    DO IR=1,ND-1
+	      RHS_MODEL(IR,JM)=RHS_MODEL(IR,JM)+RHS_dHdCHI(IR,JF)*PCHI(JF,JM)
+	    END DO
+	  END DO
+	END DO
+	CALL SIMPTH(TA,TB,TC,ESC_RESPONSE,ND,NC)
+	DO JM=1,NC
+	  DO IR=1,ND-1
+	    ESC_H(IR,JM)=(HU(IR)-EPS_B(IR))*ESC_RESPONSE(IR+1,JM)
+	1                     -(HL(IR)+EPS_A(IR))*ESC_RESPONSE(IR,JM)
+	  END DO
+	END DO
+        IF(LIMIT_ACTIVE)THEN
+          DO LIM_J=1,NC
+            CALL MOM_JH_LIMIT_COLUMN(ESC_RESPONSE(:,LIM_J),ESC_H(:,LIM_J),
+     1        J_FACTOR,H_LIMITED,H_DJL,H_DJR,HU,HL,EPS_A,EPS_B,ND)
+          END DO
+        END IF
+
+
+!
+! Evaluate the intensity variations.
+!                                  TX=dJ/d(chi,eta,....)
+!                          and     TVX=dRSQH/d(chi,eta,...)
+!
+! WORKMAT is dimension (ND,ND) is is used to temporarily save TX( , ,K) for
+! each K.
+!
+	CALL TUNE(1,'UP_TX')
+	CALL UP_TX_TVX_GRID_V1(TX,TVX,KI_MODEL,TA,TB,TC,PSIPREV_MOD,
+	1                       VB,VC,HU,HL,HS,RHS_MODEL,
+	1                       EPS_A,EPS_B,EPS_PREV_A,EPS_PREV_B,
+	1                       OLD_MODEL,ND,NC,NM,NM_KI,
+	1                       DTAU_BND,OUT_BC_TYPE,
+	1                       INIT,DO_THIS_TX_MATRIX)
+	CALL TUNE(2,'UP_TX')
+        IF(LIMIT_ACTIVE)THEN
+          DO LIM_K=1,NM
+            IF(.NOT.DO_THIS_TX_MATRIX(LIM_K))CYCLE
+            DO LIM_J=1,NC
+              CALL MOM_JH_LIMIT_COLUMN(TX(:,LIM_J,LIM_K),TVX(:,LIM_J,LIM_K),
+     1          J_FACTOR,H_LIMITED,H_DJL,H_DJR,HU,HL,EPS_A,EPS_B,ND)
+            END DO
+          END DO
+        END IF
+
+!
+! 
+!
+! Evaluate diffusion variation. TXD is initially the value from the
+! previous frequency.
+!
+	DO I=1,ND
+	  TX_OLD_d_T(I)=TX_DIF_d_T(I)
+	  TX_OLD_d_dTdR(I)=TX_DIF_d_dTDR(I)
+	END DO
+	IF(INNER_BND_METH .EQ. 'DIFFUSION')THEN
+	  TX_DIF_d_T(1)=PSIPREV(1)*TX_DIF_d_T(1)
+	  TX_DIF_d_dTdR(1)=PSIPREV(1)*TX_DIF_d_dTdR(1)
+	  IF(OUT_BC_TYPE.GT.1)THEN
+	    TX_DIF_d_T(1)=-PSIPREV(1)*TX_OLD_d_T(1)-HS(1)*TVX_DIF_d_T(1)/DTAU_BND
+	1      -(EPS_PREV_A(1)*TX_OLD_d_T(1)+EPS_PREV_B(1)*TX_OLD_d_T(2))/DTAU_BND
+	    TX_DIF_d_dTdR(1)=-PSIPREV(1)*TX_OLD_d_dTdR(1)-HS(1)*TVX_DIF_d_dTdR(1)/DTAU_BND
+	1      -(EPS_PREV_A(1)*TX_OLD_d_dTdR(1)+EPS_PREV_B(1)*TX_OLD_d_dTdR(2))/DTAU_BND
+	  END IF
+
+	  DO I=2,ND-1
+	    TX_DIF_d_T(I)= PSIPREV_MOD(I)*TX_DIF_d_T(I)
+	1             + VB(I)*TVX_DIF_d_T(I-1) + VC(I)*TVX_DIF_d_T(I)
+	1          + ( EPS_PREV_B(I)*TX_OLD_d_T(I+1)
+	1               - EPS_PREV_A(I-1)*TX_OLD_d_T(I-1) )
+	    TX_DIF_d_dTdR(I)= PSIPREV_MOD(I)*TX_DIF_d_dTdR(I)
+	1             + VB(I)*TVX_DIF_d_dTdR(I-1) + VC(I)*TVX_DIF_d_dTdR(I)
+	1          + ( EPS_PREV_B(I)*TX_OLD_d_dTdR(I+1)
+	1               - EPS_PREV_A(I-1)*TX_OLD_d_dTdR(I-1) )
+	  END DO
+	  TX_DIF_d_T(ND)=dDBBdT*R(ND)*R(ND)/3.0_LDP/CHI(ND) +
+	1                       PSIPREV(ND)*TX_DIF_d_T(ND)
+	  TX_DIF_d_dTdR(ND)=DBB/dTdR*R(ND)*R(ND)/3.0_LDP/CHI(ND) +
+	1                       PSIPREV(ND)*TX_DIF_d_dTdR(ND)
+!
+! Solve for the radiation field along ray for this frequency.
+!
+	  CALL SIMPTH(TA,TB,TC,TX_DIF_d_T,ND,1)
+	  CALL SIMPTH(TA,TB,TC,TX_DIF_d_dTdR,ND,1)
+!
+	  DO I=1,ND-1
+	    TVX_DIF_d_T(I)=HU(I)*TX_DIF_d_T(I+1) - HL(I)*TX_DIF_d_T(I) +
+	1        HS(I)*TVX_DIF_d_T(I) +
+	1        (EPS_PREV_A(I)*TX_OLD_d_T(I)-EPS_A(I)*TX_DIF_d_T(I)) +
+	1        (EPS_PREV_B(I)*TX_OLD_d_T(I+1)-EPS_B(I)*TX_DIF_d_T(I+1))
+	    TVX_DIF_d_dTdR(I)=HU(I)*TX_DIF_d_dTdR(I+1) -
+	1     HL(I)*TX_DIF_d_dTdR(I) +
+	1     HS(I)*TVX_DIF_d_dTdR(I) +
+	1     (EPS_PREV_A(I)*TX_OLD_d_dTdR(I)-EPS_A(I)*TX_DIF_d_dTdR(I)) +
+	1     (EPS_PREV_B(I)*TX_OLD_d_dTdR(I+1)-EPS_B(I)*TX_DIF_d_dTdR(I+1))
+	  END DO
+!
+        IF(LIMIT_ACTIVE)THEN
+          CALL MOM_JH_LIMIT_COLUMN(TX_DIF_d_T,TVX_DIF_d_T,
+     1      J_FACTOR,H_LIMITED,H_DJL,H_DJR,HU,HL,EPS_A,EPS_B,ND)
+          CALL MOM_JH_LIMIT_COLUMN(TX_DIF_d_dTdR,TVX_DIF_d_dTdR,
+     1      J_FACTOR,H_LIMITED,H_DJL,H_DJR,HU,HL,EPS_A,EPS_B,ND)
+        END IF
+	END IF	    	    !DIF END
+!
+! 
+!
+! Save JNU and RSQ_HNU for next frequency integration.
+!
+	DO I=1,ND
+	  JNU(I)=J_USED(I)
+	  JNUM1(I)=J_USED(I)
+	  RSQ_HNUM1(I)=RSQ_HNU(I)
+	END DO
+!
+	RETURN
+	END
+
+! Reconstruct the same piecewise radiation map as ordinary MOM_J_CMF_V11.
+! J is intensity; H is r**2 times flux. H_DJL/H_DJR differentiate the active
+! signed bound with respect to the repaired intensities at its two nodes.
+        SUBROUTINE MOM_JH_LIMIT_STATE(J_RAW,J_USED,J_FACTOR,H_USED,
+     1       H_LIMITED,H_DJL,H_DJR,R,HU,HL,HS,EPS_A,EPS_B,
+     1       EPS_PREV_A,EPS_PREV_B,J_PREV,H_PREV,H_CHK_OPTION,ND)
+        USE SET_KIND_MODULE
+        IMPLICIT NONE
+        INTEGER ND,I
+        REAL(KIND=LDP) J_RAW(ND),J_USED(ND),J_FACTOR(ND),H_USED(ND)
+        REAL(KIND=LDP) R(ND),HU(ND),HL(ND),HS(ND),EPS_A(ND),EPS_B(ND)
+        REAL(KIND=LDP) EPS_PREV_A(ND),EPS_PREV_B(ND),J_PREV(ND),H_PREV(ND)
+        REAL(KIND=LDP) H_DJL(ND-1),H_DJR(ND-1),BOUND,FAC
+        LOGICAL H_LIMITED(ND-1)
+        CHARACTER(LEN=*) H_CHK_OPTION
+        J_USED=J_RAW; J_FACTOR=1.0_LDP
+        WHERE(J_RAW.LT.0.0_LDP)
+          J_USED=ABS(J_RAW)/10.0_LDP
+          J_FACTOR=-0.1_LDP
+        END WHERE
+        H_LIMITED=.FALSE.; H_DJL=0.0_LDP; H_DJR=0.0_LDP
+        DO I=1,ND-1
+          H_USED(I)=HU(I)*J_USED(I+1)-HL(I)*J_USED(I)+HS(I)*H_PREV(I)+
+     1      (EPS_PREV_A(I)*J_PREV(I)-EPS_A(I)*J_USED(I))+
+     1      (EPS_PREV_B(I)*J_PREV(I+1)-EPS_B(I)*J_USED(I+1))
+          IF(H_CHK_OPTION.EQ.'AV_VAL')THEN
+            BOUND=(R(I)*R(I)*J_USED(I)+R(I+1)*R(I+1)*J_USED(I+1))/2.0_LDP
+          ELSE IF(H_CHK_OPTION.EQ.'MAX_VAL')THEN
+            BOUND=MAX(R(I)*R(I)*J_USED(I),R(I+1)*R(I+1)*J_USED(I+1))
+          ELSE
+            CYCLE
+          END IF
+          IF(ABS(H_USED(I)).LE.BOUND)CYCLE
+          FAC=SIGN(0.99999_LDP,H_USED(I))
+          H_USED(I)=FAC*BOUND
+          H_LIMITED(I)=.TRUE.
+          IF(H_CHK_OPTION.EQ.'AV_VAL')THEN
+            H_DJL(I)=FAC*R(I)*R(I)/2.0_LDP
+            H_DJR(I)=FAC*R(I+1)*R(I+1)/2.0_LDP
+          ELSE IF(R(I)*R(I)*J_USED(I).GE.R(I+1)*R(I+1)*J_USED(I+1))THEN
+            H_DJL(I)=FAC*R(I)*R(I)
+          ELSE
+            H_DJR(I)=FAC*R(I+1)*R(I+1)
+          END IF
+        END DO
+        END
+
+! The coefficient derivative of H is linear in current J. Add its change
+! when J is repaired; previous J/H terms cancel. Do not alter the raw-J
+! matrix-equation partials in KI. dTAUdCHI follows the native quadrature.
+        SUBROUTINE MOM_JH_CHI_CORRECTION(RHS,DELTA_J,dTAUdCHI,
+     1       CHI,DTAU,HU,HL,W,EPS_A,EPS_B,ND)
+        USE SET_KIND_MODULE
+        IMPLICIT NONE
+        INTEGER ND,I,L
+        REAL(KIND=LDP) RHS(ND-1,ND),DELTA_J(ND),dTAUdCHI(ND,ND)
+        REAL(KIND=LDP) CHI(ND),DTAU(ND),HU(ND),HL(ND),W(ND)
+        REAL(KIND=LDP) EPS_A(ND),EPS_B(ND),T1,T2
+        DO I=1,ND-1
+          T1=(-HU(I)*DELTA_J(I+1)+HL(I)*DELTA_J(I))/DTAU(I)
+          DO L=1,ND
+            RHS(I,L)=RHS(I,L)+T1*dTAUdCHI(I,L)
+          END DO
+          T2=(1.0_LDP+W(I))*(CHI(I)+CHI(I+1))
+          T1=((HU(I)*DELTA_J(I+1)-HL(I)*DELTA_J(I))*W(I)+
+     1         EPS_A(I)*DELTA_J(I)+EPS_B(I)*DELTA_J(I+1))/T2
+          RHS(I,I)=RHS(I,I)+T1
+          RHS(I,I+1)=RHS(I,I+1)+T1
+        END DO
+        END
+
+! Chain one raw response column through the J repair, H reconstruction,
+! and signed H cap. The incoming H column already includes repaired-J
+! coefficient partials and the correctly limited previous-frequency history.
+        SUBROUTINE MOM_JH_LIMIT_COLUMN(DJ,DH,J_FACTOR,H_LIMITED,
+     1       H_DJL,H_DJR,HU,HL,EPS_A,EPS_B,ND)
+        USE SET_KIND_MODULE
+        IMPLICIT NONE
+        INTEGER ND,I
+        REAL(KIND=LDP) DJ(ND),DH(ND-1),J_FACTOR(ND)
+        REAL(KIND=LDP) H_DJL(ND-1),H_DJR(ND-1)
+        REAL(KIND=LDP) HU(ND),HL(ND),EPS_A(ND),EPS_B(ND)
+        LOGICAL H_LIMITED(ND-1)
+        DO I=1,ND-1
+          DH(I)=DH(I)+(HU(I)-EPS_B(I))*(J_FACTOR(I+1)-1.0_LDP)*DJ(I+1)
+     1               -(HL(I)+EPS_A(I))*(J_FACTOR(I)-1.0_LDP)*DJ(I)
+        END DO
+        DJ=J_FACTOR*DJ
+        DO I=1,ND-1
+          IF(H_LIMITED(I))DH(I)=H_DJL(I)*DJ(I)+H_DJR(I)*DJ(I+1)
+        END DO
+        END
