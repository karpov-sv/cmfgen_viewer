+! Return a bounded filling-factor multiplier. Emissivity scales as FILL**2.
+! Invalid luminosities never enter arithmetic or silently pass convergence.
+      SUBROUTINE CMFGEN_XRAY_SCALE(OBS,TARGET,TOL,FACTOR,CHANGED,VALID)
+      USE SET_KIND_MODULE
+      USE, INTRINSIC :: IEEE_ARITHMETIC
+      IMPLICIT NONE
+      REAL(KIND=LDP) OBS,TARGET,TOL,FACTOR,A,B,LIMIT
+      LOGICAL CHANGED,VALID
+      FACTOR=1.0_LDP
+      CHANGED=.FALSE.
+      VALID=.FALSE.
+      IF(.NOT. IEEE_IS_FINITE(OBS))RETURN
+      IF(.NOT. IEEE_IS_FINITE(TARGET))RETURN
+      IF(.NOT. IEEE_IS_FINITE(TOL))RETURN
+      IF(OBS .LT. 0.0_LDP .OR. TARGET .LE. 0.0_LDP .OR. TOL .LT. 0.0_LDP)RETURN
+      VALID=.TRUE.
+! Avoid overflow even for an unphysical very large tolerance.
+      IF(TOL .GT. 1.0_LDP)THEN
+        IF(TARGET .GT. HUGE(TARGET)/TOL)RETURN
+      END IF
+      LIMIT=TOL*TARGET
+      IF(ABS(OBS-TARGET) .LE. LIMIT)RETURN
+      A=SQRT(TARGET)
+      B=SQRT(OBS)
+      IF(B .LE. A/10.0_LDP)THEN
+        FACTOR=10.0_LDP
+      ELSE IF(A .LE. B/10.0_LDP)THEN
+        FACTOR=0.1_LDP
+      ELSE
+        FACTOR=A/B
+      END IF
+      CHANGED=.TRUE.
+      END
+!
+! A changed source requires a new solved update, even after cycle overrides
+! or an IN_ITS reread. A budget of one only writes a final formal spectrum.
+      SUBROUTINE CMFGEN_XRAY_CONTINUE(CHANGED,MAXCH,BA,EDD,NLEFT)
+      USE SET_KIND_MODULE
+      IMPLICIT NONE
+      LOGICAL CHANGED,BA,EDD
+      INTEGER NLEFT
+      REAL(KIND=LDP) MAXCH
+      IF(.NOT. CHANGED)RETURN
+      MAXCH=MAX(MAXCH,100.0_LDP)
+      BA=.TRUE.
+      EDD=.TRUE.
+      NLEFT=MAX(NLEFT,2)
+      END
