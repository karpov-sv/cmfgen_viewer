+! Stable form of the same cubic. Steffen's limited derivatives keep these
+! Bezier control points in the endpoint interval. Positive data therefore
+! use positive sums, rather than cancelling large polynomial terms.
+      PURE FUNCTION MON_INTERP_BEZIER(Y0,Y1,D0,D1,X0,X1,X) RESULT(Y)
+      USE SET_KIND_MODULE
+      IMPLICIT NONE
+      REAL(KIND=LDP),INTENT(IN)::Y0,Y1,D0,D1,X0,X1,X
+      REAL(KIND=LDP) Y,H,U,V,C1,C2,A,B,C
+      H=X1-X0
+      C1=Y0+(H/3.0_LDP)*D0
+      C2=Y1-(H/3.0_LDP)*D1
+! Compute the small endpoint weight directly, avoiding loss in 1-t.
+      IF(ABS(X-X0) .LE. ABS(X1-X))THEN
+        V=(X-X0)/H
+        U=1.0_LDP-V
+      ELSE
+        U=(X1-X)/H
+        V=1.0_LDP-U
+      END IF
+      A=U*Y0+V*C1
+      B=U*C1+V*C2
+      C=U*C2+V*Y1
+      A=U*A+V*B
+      B=U*B+V*C
+      Y=U*A+V*B
+      END FUNCTION
