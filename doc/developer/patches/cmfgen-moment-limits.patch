+
+! Reconstruct the same piecewise radiation map as ordinary MOM_J_CMF_V11.
+! J is intensity; H is r**2 times flux. H_DJL/H_DJR differentiate the active
+! signed bound with respect to the repaired intensities at its two nodes.
+        SUBROUTINE MOM_JH_LIMIT_STATE(J_RAW,J_USED,J_FACTOR,H_USED,
+     1       H_LIMITED,H_DJL,H_DJR,R,HU,HL,HS,EPS_A,EPS_B,
+     1       EPS_PREV_A,EPS_PREV_B,J_PREV,H_PREV,H_CHK_OPTION,ND)
+        USE SET_KIND_MODULE
+        IMPLICIT NONE
+        INTEGER ND,I
+        REAL(KIND=LDP) J_RAW(ND),J_USED(ND),J_FACTOR(ND),H_USED(ND)
+        REAL(KIND=LDP) R(ND),HU(ND),HL(ND),HS(ND),EPS_A(ND),EPS_B(ND)
+        REAL(KIND=LDP) EPS_PREV_A(ND),EPS_PREV_B(ND),J_PREV(ND),H_PREV(ND)
+        REAL(KIND=LDP) H_DJL(ND-1),H_DJR(ND-1),BOUND,FAC
+        LOGICAL H_LIMITED(ND-1)
+        CHARACTER(LEN=*) H_CHK_OPTION
+        J_USED=J_RAW; J_FACTOR=1.0_LDP
+        WHERE(J_RAW.LT.0.0_LDP)
+          J_USED=ABS(J_RAW)/10.0_LDP
+          J_FACTOR=-0.1_LDP
+        END WHERE
+        H_LIMITED=.FALSE.; H_DJL=0.0_LDP; H_DJR=0.0_LDP
+        DO I=1,ND-1
+          H_USED(I)=HU(I)*J_USED(I+1)-HL(I)*J_USED(I)+HS(I)*H_PREV(I)+
+     1      (EPS_PREV_A(I)*J_PREV(I)-EPS_A(I)*J_USED(I))+
+     1      (EPS_PREV_B(I)*J_PREV(I+1)-EPS_B(I)*J_USED(I+1))
+          IF(H_CHK_OPTION.EQ.'AV_VAL')THEN
+            BOUND=(R(I)*R(I)*J_USED(I)+R(I+1)*R(I+1)*J_USED(I+1))/2.0_LDP
+          ELSE IF(H_CHK_OPTION.EQ.'MAX_VAL')THEN
+            BOUND=MAX(R(I)*R(I)*J_USED(I),R(I+1)*R(I+1)*J_USED(I+1))
+          ELSE
+            CYCLE
+          END IF
+          IF(ABS(H_USED(I)).LE.BOUND)CYCLE
+          FAC=SIGN(0.99999_LDP,H_USED(I))
+          H_USED(I)=FAC*BOUND
+          H_LIMITED(I)=.TRUE.
+          IF(H_CHK_OPTION.EQ.'AV_VAL')THEN
+            H_DJL(I)=FAC*R(I)*R(I)/2.0_LDP
+            H_DJR(I)=FAC*R(I+1)*R(I+1)/2.0_LDP
+          ELSE IF(R(I)*R(I)*J_USED(I).GE.R(I+1)*R(I+1)*J_USED(I+1))THEN
+            H_DJL(I)=FAC*R(I)*R(I)
+          ELSE
+            H_DJR(I)=FAC*R(I+1)*R(I+1)
+          END IF
+        END DO
+        END
+
+! The coefficient derivative of H is linear in current J. Add its change
+! when J is repaired; previous J/H terms cancel. Do not alter the raw-J
+! matrix-equation partials in KI. dTAUdCHI follows the native quadrature.
+        SUBROUTINE MOM_JH_CHI_CORRECTION(RHS,DELTA_J,dTAUdCHI,
+     1       CHI,DTAU,HU,HL,W,EPS_A,EPS_B,ND)
+        USE SET_KIND_MODULE
+        IMPLICIT NONE
+        INTEGER ND,I,L
+        REAL(KIND=LDP) RHS(ND-1,ND),DELTA_J(ND),dTAUdCHI(ND,ND)
+        REAL(KIND=LDP) CHI(ND),DTAU(ND),HU(ND),HL(ND),W(ND)
+        REAL(KIND=LDP) EPS_A(ND),EPS_B(ND),T1,T2
+        DO I=1,ND-1
+          T1=(-HU(I)*DELTA_J(I+1)+HL(I)*DELTA_J(I))/DTAU(I)
+          DO L=1,ND
+            RHS(I,L)=RHS(I,L)+T1*dTAUdCHI(I,L)
+          END DO
+          T2=(1.0_LDP+W(I))*(CHI(I)+CHI(I+1))
+          T1=((HU(I)*DELTA_J(I+1)-HL(I)*DELTA_J(I))*W(I)+
+     1         EPS_A(I)*DELTA_J(I)+EPS_B(I)*DELTA_J(I+1))/T2
+          RHS(I,I)=RHS(I,I)+T1
+          RHS(I,I+1)=RHS(I,I+1)+T1
+        END DO
+        END
+
+! Chain one raw response column through the J repair, H reconstruction,
+! and signed H cap. The incoming H column already includes repaired-J
+! coefficient partials and the correctly limited previous-frequency history.
+        SUBROUTINE MOM_JH_LIMIT_COLUMN(DJ,DH,J_FACTOR,H_LIMITED,
+     1       H_DJL,H_DJR,HU,HL,EPS_A,EPS_B,ND)
+        USE SET_KIND_MODULE
+        IMPLICIT NONE
+        INTEGER ND,I
+        REAL(KIND=LDP) DJ(ND),DH(ND-1),J_FACTOR(ND)
+        REAL(KIND=LDP) H_DJL(ND-1),H_DJR(ND-1)
+        REAL(KIND=LDP) HU(ND),HL(ND),EPS_A(ND),EPS_B(ND)
+        LOGICAL H_LIMITED(ND-1)
+        DO I=1,ND-1
+          DH(I)=DH(I)+(HU(I)-EPS_B(I))*(J_FACTOR(I+1)-1.0_LDP)*DJ(I+1)
+     1               -(HL(I)+EPS_A(I))*(J_FACTOR(I)-1.0_LDP)*DJ(I)
+        END DO
+        DJ=J_FACTOR*DJ
+        DO I=1,ND-1
+          IF(H_LIMITED(I))DH(I)=H_DJL(I)*DJ(I)+H_DJR(I)*DJ(I+1)
+        END DO
+        END
