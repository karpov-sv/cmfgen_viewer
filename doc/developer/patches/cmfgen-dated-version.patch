new file mode 100644
--- /dev/null
+++ b/new_main/cmfgen_version.inc
@@ -0,0 +1,4 @@
+! Maintained cumulative patch stream. Bump date/revision for every release.
+      CHARACTER(LEN=*), PARAMETER :: PRODATE='31-Oct-2026'
+      CHARACTER(LEN=*), PARAMETER :: UPSTREAM_DATE='18-Jun-2025'
+      CHARACTER(LEN=*), PARAMETER :: PATCH_REVISION='2026-10-31.1'
